{
  "expo": {
    "name": "PaiPai",
    "slug": "paipai",
    "scheme": "paipai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F8F5",
    "ios": {
      "bundleIdentifier": "com.paipai.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Allow PaiPai to use Face ID to unlock the app."
      }
    },
    "android": {
      "package": "com.paipai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#B6E36B"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#B6E36B",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#B6E36B"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#B6E36B"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PaiPai to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PaiPai to attach receipt photos and set your profile picture.",
          "cameraPermission": "Allow PaiPai to take photos of receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
