# ─────────────────────────────────────────────────────────────
# PaiPai — environment variables (placeholders only, never commit real values)
# Copy to `.env` in the app that needs it. See docs/SETUP-KEYS.md for how to get each key.
# ─────────────────────────────────────────────────────────────

# ── Database (packages/db, apps/api) ─────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/paipai?sslmode=require"

# ── Auth (apps/api) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-bytes"
# Public URL of the API (Better Auth base URL)
BETTER_AUTH_URL="http://localhost:8787"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# ── Email (apps/api) ─────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="PaiPai <hello@yourdomain.com>"

# ── URLs ─────────────────────────────────────────────────────
WEB_URL="http://localhost:3000"
API_URL="http://localhost:8787"
NEXT_PUBLIC_API_URL="http://localhost:8787"
# On a physical phone use your machine's LAN IP, e.g. http://192.168.1.10:8787
EXPO_PUBLIC_API_URL="http://localhost:8787"

# ── Receipts (optional — feature is hidden if unset) ─────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket URL or custom domain, e.g. https://receipts.yourdomain.com
R2_PUBLIC_URL=""

# ── Cron (apps/api) ──────────────────────────────────────────
# Shared secret for the recurring-transactions cron endpoint
CRON_SECRET="replace-with-random-string"

# Production only: share the session cookie between web and API subdomains, e.g. ".paipai.app"
COOKIE_DOMAIN=""
